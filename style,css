/* ===========================
   GOOGLE FONT & ROOT COLORS
=========================== */

:root{
    --primary:#2563eb;
    --secondary:#1e40af;
    --accent:#38bdf8;
    --dark:#0f172a;
    --light:#f8fafc;
    --gray:#64748b;
    --white:#ffffff;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:linear-gradient(135deg,#f8fbff,#e0f2fe);
    color:var(--dark);
    line-height:1.7;
}

/* ===========================
      NAVIGATION BAR
=========================== */

nav{

    position:sticky;
    top:0;
    width:100%;
    background:var(--dark);

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:18px 8%;
    z-index:1000;

    box-shadow:0 5px 15px rgba(0,0,0,.2);

}

.logo{

    color:white;
    font-size:28px;
    font-weight:700;
    letter-spacing:1px;

}

nav ul{

    display:flex;
    list-style:none;
    gap:30px;

}

nav ul li a{

    color:white;
    text-decoration:none;
    font-size:17px;
    font-weight:500;
    transition:.3s;

}

nav ul li a:hover{

    color:var(--accent);
    border-bottom:2px solid var(--accent);
    padding-bottom:4px;

}

/* ===========================
        HERO SECTION
=========================== */

.hero{

    min-height:100vh;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:100px 8%;

    gap:60px;

    animation:fadeUp 1s ease;

}

.hero-text{

    flex:1;

}

.hero-text h1{

    font-size:64px;
    margin-bottom:20px;
    font-weight:700;

    background:linear-gradient(90deg,#2563eb,#38bdf8);
    -webkit-background-clip:text;
    color:transparent;

}

.hero-text h3{

    color:var(--primary);
    margin-bottom:20px;
    font-size:30px;

}

.hero-text p{

    font-size:18px;
    color:var(--gray);
    margin-bottom:18px;

}

.btn{

    display:inline-block;

    margin-top:25px;

    background:linear-gradient(90deg,#2563eb,#38bdf8);

    color:white;

    padding:15px 35px;

    border-radius:50px;

    text-decoration:none;

    font-weight:600;

    transition:.4s;

}

.btn:hover{

    transform:translateY(-4px);

    box-shadow:0 10px 20px rgba(0,0,0,.2);

}

/* ===========================
      HERO IMAGE
=========================== */

.hero-image{

    flex:1;
    display:flex;
    justify-content:center;
    align-items:center;

}

.hero-image img{

    width:360px;
    height:360px;

    border-radius:50%;

    object-fit:cover;

    border:8px solid #38bdf8;

    box-shadow:0 20px 40px rgba(0,0,0,.2);

    transition:.4s;

}

.hero-image img:hover{

    transform:scale(1.08) rotate(2deg);

}

/* ===========================
        SECTION
=========================== */

section{

    padding:80px 8%;
    scroll-margin-top:90px;

}

section h2{

    text-align:center;

    font-size:40px;

    margin-bottom:50px;

    color:var(--secondary);

}

/* ===========================
      ABOUT SECTION
=========================== */

.about-container{

    background:white;

    padding:40px;

    border-radius:20px;

    box-shadow:0 10px 25px rgba(0,0,0,.1);

}

.about-container:hover{

    transform:translateY(-5px);

    transition:.3s;

}

.about-container p{

    margin-bottom:20px;

    font-size:18px;

    color:#444;

}

.about-container strong{

    color:var(--secondary);

}

.about-container mark{

    background:#fde68a;
    padding:2px 6px;

}

.about-container em{

    color:var(--primary);

}
/* ===========================
      SKILLS SECTION
=========================== */

.skills-container{

    display:flex;

    gap:40px;

    justify-content:center;

    flex-wrap:wrap;

}

.skill-box{

    background:white;

    padding:30px;

    border-radius:20px;

    width:450px;

    box-shadow:0 10px 20px rgba(0,0,0,.1);

    transition:.3s;

}

.skill-box:hover{

    background:#eff6ff;

    transform:translateY(-5px);

}

.skill-box h3{

    margin-bottom:25px;

    color:var(--secondary);

}

.skill-box span{

    display:inline-block;

    background:var(--primary);

    color:white;

    padding:10px 18px;

    border-radius:25px;

    margin:8px;

    font-size:15px;

    transition:.3s;

}

.skill-box span:hover{

    background:var(--secondary);

    transform:scale(1.1);

}

/* ===========================
      PROJECT SECTION
=========================== */

.project-container{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(320px,1fr));

    gap:30px;

}

.card{

    background:white;

    padding:30px;

    border-radius:20px;

    border-top:5px solid var(--primary);

    box-shadow:0 15px 30px rgba(0,0,0,.1);

    transition:.3s;

}

.card:hover{

    transform:translateY(-8px);

    box-shadow:0 20px 40px rgba(0,0,0,.2);

}

.card h3{

    color:var(--secondary);

    margin-bottom:20px;

}

.card:hover h3{

    color:var(--primary);

}

.card p{

    color:#555;

    margin-bottom:25px;

}

.card a{

    display:inline-block;

    text-decoration:none;

    background:var(--primary);

    color:white;

    padding:12px 22px;

    border-radius:30px;

    transition:.3s;

}

.card a:hover{

    background:var(--secondary);

}

/* ===========================
      CONTACT SECTION
=========================== */

#contact{

    background:#ffffff;

}

form{

    max-width:700px;

    margin:auto;

    background:white;

    padding:40px;

    border-radius:20px;

    box-shadow:0 10px 30px rgba(0,0,0,.1);

}

form label{

    display:block;

    margin-top:20px;

    margin-bottom:8px;

    font-weight:600;

    color:var(--secondary);

}

form input,
form textarea{

    width:100%;

    padding:14px;

    border:2px solid #dbeafe;

    border-radius:10px;

    font-size:16px;

    font-family:'Poppins',sans-serif;

    transition:.3s;

}

form textarea{

    resize:none;

}

form input:focus,
form textarea:focus{

    outline:none;

    border-color:var(--primary);

    box-shadow:0 0 10px rgba(37,99,235,.3);

}

form button{

    width:100%;

    margin-top:25px;

    background:var(--primary);

    color:white;

    border:none;

    padding:15px;

    font-size:18px;

    border-radius:10px;

    cursor:pointer;

    transition:.3s;

}

form button:hover{

    background:var(--secondary);

    transform:translateY(-3px);

    box-shadow:0 10px 20px rgba(0,0,0,.2);

}
/* ===========================
          FOOTER
=========================== */

footer{

    background:var(--dark);

    color:white;

    text-align:center;

    padding:40px 20px;

}

footer address{

    font-style:normal;

    margin-bottom:15px;

    color:#cbd5e1;

}

footer p{

    margin-bottom:15px;

}

footer div{

    margin-top:10px;

}

footer a{

    color:var(--accent);

    text-decoration:none;

    margin:0 15px;

    font-weight:600;

    transition:.3s;

}

footer a:hover{

    color:white;

}

/* ===========================
      SCROLLBAR
=========================== */

::-webkit-scrollbar{

    width:10px;

}

::-webkit-scrollbar-track{

    background:#e2e8f0;

}

::-webkit-scrollbar-thumb{

    background:var(--primary);

    border-radius:10px;

}

::-webkit-scrollbar-thumb:hover{

    background:var(--secondary);

}

/* ===========================
      ANIMATIONS
=========================== */

@keyframes fadeUp{

    from{

        opacity:0;

        transform:translateY(40px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}

.about-container,
.skill-box,
.card,
form{

    animation:fadeUp 1s ease;

}

@keyframes pulse{

    0%{

        transform:scale(1);

    }

    50%{

        transform:scale(1.05);

    }

    100%{

        transform:scale(1);

    }

}

.btn{

    animation:pulse 2s infinite;

}

/* ===========================
      EXTRA DESIGN
=========================== */

body{

    background-attachment:fixed;

}

section:nth-child(even){

    background:#f8fbff;

}

section:nth-child(odd){

    background:#ffffff;

}

h1,h2,h3{

    letter-spacing:1px;

}

p{

    text-align:justify;

}

.btn,
.card,
.skill-box,
form{

    transition:all .3s ease;

}

/* ===========================
      RESPONSIVE DESIGN
=========================== */

@media(max-width:768px){

    nav{

        flex-direction:column;

        padding:20px;

    }

    nav ul{

        flex-direction:column;

        gap:15px;

        margin-top:15px;

        text-align:center;

    }

    .hero{

        flex-direction:column-reverse;

        text-align:center;

        padding-top:150px;

    }

    .hero-text h1{

        font-size:42px;

    }

    .hero-text h3{

        font-size:24px;

    }

    .hero-image img{

        width:250px;

        height:250px;

    }

    .skills-container{

        flex-direction:column;

        align-items:center;

    }

    .skill-box{

        width:100%;

    }

    .project-container{

        grid-template-columns:1fr;

    }

    form{

        padding:25px;

    }

}